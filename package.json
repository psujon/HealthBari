{
  "name": "healthbari-fullstack",
  "version": "1.0.0",
  "description": "হেলথ বাড়ি (HealthBari) - Unified Single Node Modules Fullstack E-Commerce",
  "main": "server/server.js",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "start": "node server/server.js",
    "server": "npm run start --workspace=server",
    "client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
